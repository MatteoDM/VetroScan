{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v py >/dev/null 2>&1; then py -3.13 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scanner_guard.py\"; else python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scanner_guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v py >/dev/null 2>&1; then py -3.13 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt_edited.py\"; else python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt_edited.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
